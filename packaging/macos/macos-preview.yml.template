name: macOS app - Apple Silicon preview

on:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: macos-preview-${{ github.ref }}
  cancel-in-progress: false

jobs:
  build:
    name: Build and verify Apple Silicon app
    runs-on: macos-15
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v7
        with:
          persist-credentials: false
      - uses: actions/setup-python@v7
        with:
          python-version: '3.14.8'
          architecture: arm64
          cache: pip
          cache-dependency-path: packaging/macos/requirements.txt
      - name: Install build dependencies
        run: python -m pip install -r packaging/macos/requirements.txt
      - name: Build app and run offline package verification
        run: python tools/build_macos.py --arch arm64
      - name: Upload ready-to-open application ZIP
        uses: actions/upload-artifact@v7
        with:
          name: DSP408FIR-Control-macOS-Apple-Silicon.zip
          path: dist/macos/arm64/DSP408FIR-Control-*-macOS-arm64.zip
          archive: false
          if-no-files-found: error
          retention-days: 14
      - name: Upload verification report and checksum
        if: always()
        uses: actions/upload-artifact@v7
        with:
          name: macOS-build-verification
          path: |
            work/macos-arm64-verification/verification.json
            dist/macos/arm64/*.sha256
          if-no-files-found: ignore
          retention-days: 14
